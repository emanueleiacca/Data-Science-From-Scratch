source("Func10.10.R")
'''
# Linear Congruential Generator with the ANSI C default (Saucier, 2000)
lcg <- function(n = 100, M = 2^32, a = 12345, b = 1103515245, u0 = as.numeric(Sys.time()) * 100) {
out <- rep(NA, n)  # Allocate output
# Main loop
for (i in 1:n) {
u0 <- (a + b * u0) %% M
out[i] <- u0 / (M + 1)
}
return(out)
}
'''
lcg #body function
ex <- lcg(u0=42) #ex
# if u know the seed, u know the sequence
hist(ex, prob = T)
curve(dunif(x,0,1), add = T, lwd = 4)
#it doesn't look like an uniform distribution
?rgamma
?NaN # Not avaible number, usually it's returned from not possible math operation
#if u add ? to a known function in R u can ask for help to R
?NA # so not avaible
?NULL # not existent
#is.na() # return a vector of booleans
# d-acro | PDF or PMF
# p-acro | CDF or Survival Fun (1-CDF)
# q-acro | Quantile
# r-acro | Simulating *pseudo* random number
#?dbinom
#?dgeom
#?dpois
#?dunif
#?dexp
# Pick colors
colo <- c(
rgb(32 / 255, 74 / 255, 135 / 255, 0.7),
rgb(204 / 255, 0, 0, 0.7),
rgb(200 / 255, 141 / 255, 0, 0.7),
rgb(78 / 255, 153 / 255, 6 / 255, 0.7)
)
# Set parameters
pp <- c(0.5, 0.7)
nn <- c(20, 40)
# Plot PMF
plot(0:nn[1], dbinom(0:nn[1], nn[1], pp[1]),
xlim = c(0, 40), ylim = c(0, 0.25),
type = "b", lty = 3,
xlab = "", ylab = "",
col = gray(0.8), pch = 21, bg = colo[1])
lines(0:nn[1], dbinom(0:nn[1], nn[1], pp[2]),
type = "b", lty = 3,
col = gray(0.8), pch = 21, bg = colo[2])
lines(0:nn[2], dbinom(0:nn[2], nn[2], pp[1]),
type = "b", lty = 3,
col = gray(0.8), pch = 21, bg = colo[3])
lines(0:nn[2], dbinom(0:nn[2], nn[2], pp[2]),
type = "b", lty = 3,
col = gray(0.8), pch = 21, bg = colo[4])
grid()
legend("topleft",
c("p = 0.5, n = 20", "p = 0.7, n = 20",
"p = 0.5, n = 40", "p = 0.7, n = 40"),
col = colo, pch = 19,
bty = "n", cex = 0.8)
#Plot CDF

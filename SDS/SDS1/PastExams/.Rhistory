for (p in 1:P) {
# Generate a new Monte Carlo reference sample
reference_samples_p <- data.frame(matrix(ncol = ncol(df_multiclass) - 1, nrow = M))
for (feature in colnames(df_multiclass)[-ncol(df_multiclass)]) {
reference_samples_p[[feature]] <- rnorm(M, mean(df_multiclass[[feature]], na.rm = TRUE),
sd(df_multiclass[[feature]], na.rm = TRUE))
}
reference_samples_p$HR_Zone <- -1  # Label for reference data
df_combined_p <- rbind(df_multiclass, reference_samples_p)
# Train model on real + artificial data
model_gof_p <- multinom(HR_Zone ~ ., data = df_combined_p)
# Compute KS Test on the artificial data
pred_probs_gof_p <- predict(model_gof_p, df_combined_p, type = "probs")
perm_values_gof[p] <- ks.test(pred_probs_gof_p[df_combined_p$HR_Zone != -1, 2],
pred_probs_gof_p[df_combined_p$HR_Zone == -1, 2])$statistic
}
set.seed(42)
P <- 100  # Number of Monte Carlo samples
perm_values_gof <- numeric(P)
# Extract feature names (excluding HR_Zone)
feature_names <- colnames(df_multiclass)[-ncol(df_multiclass)]
M <- nrow(df_multiclass)  # Match the size of the real dataset
for (p in 1:P) {
# Generate a new Monte Carlo reference sample with correct structure
reference_samples_p <- as.data.frame(matrix(ncol = length(feature_names), nrow = M))
colnames(reference_samples_p) <- feature_names  # Ensure matching feature names
for (feature in feature_names) {
reference_samples_p[[feature]] <- rnorm(M, mean(df_multiclass[[feature]], na.rm = TRUE),
sd(df_multiclass[[feature]], na.rm = TRUE))
}
# Assign label for synthetic reference samples
reference_samples_p$HR_Zone <- -1
# Ensure column order matches before rbind()
df_combined_p <- rbind(df_multiclass, reference_samples_p)
# Convert HR_Zone to a factor for consistency
df_combined_p$HR_Zone <- as.factor(df_combined_p$HR_Zone)
# Train model on real + artificial data
model_gof_p <- multinom(HR_Zone ~ ., data = df_combined_p)
# Compute KS Test on the artificial data
pred_probs_gof_p <- predict(model_gof_p, df_combined_p, type = "probs")
# Ensure indexing is done properly for KS test
perm_values_gof[p] <- ks.test(pred_probs_gof_p[df_combined_p$HR_Zone != "-1", 2],
pred_probs_gof_p[df_combined_p$HR_Zone == "-1", 2])$statistic
}
set.seed(42)
P <- 100  # Number of Monte Carlo samples
perm_values_gof <- numeric(P)
# Extract feature names (excluding HR_Zone)
feature_names <- colnames(df_multiclass)[-ncol(df_multiclass)]
M <- nrow(df_multiclass)  # Match the size of the real dataset
for (p in 1:P) {
# Generate a new Monte Carlo reference sample
reference_samples_p <- as.data.frame(matrix(ncol = length(feature_names), nrow = M))
colnames(reference_samples_p) <- feature_names  # Ensure matching feature names
for (feature in feature_names) {
reference_samples_p[[feature]] <- rnorm(M, mean(df_multiclass[[feature]], na.rm = TRUE),
sd(df_multiclass[[feature]], na.rm = TRUE))
}
# Ensure no missing or constant values in generated samples
reference_samples_p <- na.omit(reference_samples_p)
reference_samples_p <- reference_samples_p[, sapply(reference_samples_p, function(x) length(unique(x)) > 1)]
# Assign label for synthetic reference samples
reference_samples_p$HR_Zone <- -1
# Ensure column order matches before rbind()
df_combined_p <- rbind(df_multiclass, reference_samples_p)
# Convert HR_Zone to a factor for consistency
df_combined_p$HR_Zone <- as.factor(df_combined_p$HR_Zone)
# Train model on real + artificial data
model_gof_p <- tryCatch({
multinom(HR_Zone ~ ., data = df_combined_p)
}, error = function(e) return(NULL))  # Return NULL if model fails
if (is.null(model_gof_p)) next  # Skip iteration if model failed
# Compute KS Test on the artificial data
pred_probs_gof_p <- predict(model_gof_p, df_combined_p, type = "probs")
# Ensure indexing is done properly for KS test
real_group <- pred_probs_gof_p[df_combined_p$HR_Zone != "-1", 2]
ref_group <- pred_probs_gof_p[df_combined_p$HR_Zone == "-1", 2]
if (length(unique(real_group)) > 1 & length(unique(ref_group)) > 1) {
perm_values_gof[p] <- ks.test(real_group, ref_group)$statistic
} else {
perm_values_gof[p] <- NA  # Assign NA if KS test cannot be performed
}
}
# Remove NA values from permutation results
perm_values_gof <- na.omit(perm_values_gof)
# Compute Power Estimate
p_greater_gof <- mean(perm_values_gof >= ks_real_vs_ref$statistic, na.rm = TRUE)

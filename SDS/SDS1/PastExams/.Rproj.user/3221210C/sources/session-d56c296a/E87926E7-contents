h_prior <- c(a=my_prior_a,b=my_prior_b)
h_prior

curve(dbeta(x,shape1=my_prior_a,shape2=my_prior_b), ylim=c(0,2), xlab=expression(theta),ylab=expression(pi[h]~(theta)))
title(main="prior distribution")

# Let us evaluate  the corresponding prior statements in terms of expected value and probability content of a specific interval of theta values

my_prior_a /(my_prior_b+my_prior_a)
# expected value a priori
mu_prior <- my_prior_a /(my_prior_b+my_prior_a)

# prior prob of [0.05,0.2]
pbeta(0.2,shape1=my_prior_a,shape2 = my_prior_b)-pbeta(0.05,shape1=my_prior_a,shape2 = my_prior_b)


# d. HYPOTHESIS TESTING ---------------------------------------------------
#    test whether or not the prevalence is larger than 10% -------------------




# POSTERIOR DISTRIBUTION: 
# hypothesis testing


# for composite hypothesis [where H_0 corresponds to an interval of values of theta]
# one need to look at its posterior probability content
# and decide according to whether this is a sufficiently large probability 
# value to support H_0 rather than H_1 
# one can consider 0.5 as a minimal threshold for deciding in favor of that hypothesis

# H_0 : theta <= 0.1     [0,0.1]= Theta_0 (null hypothesis)
# H_1 : theta > 0.1      (0.1,1]= Theta_1 (alternative hypothesis)

# Let us compute the posterior probability of the null hypothesis [0,0.1]= Theta_0
pbeta(0.1,shape1 = my_posterior_a,shape2=my_posterior_b)

# Let us compute the posterior probability of the alternative (0.1,1]= Theta_1
1-pbeta(0.1,shape1 = my_posterior_a,shape2=my_posterior_b)

# Note that, differently from the frequentist approach if we 
# switch the null with the alternative in the hypothesis system

# the conclusions must be the same!!

# H_0: theta >= 0.1

(1-pbeta(0.1,shape1 = my_prior_a,shape2=my_prior_b))

# H_1: theta < 0.1

pbeta(0.1,shape1 = my_prior_a,shape2=my_prior_b)

# 
# in order to discount the effect of the prior probability content? 

# BF = (posterior odds) / (prior odds)

prior_odds_01 <- (1-pbeta(0.1,shape1 = my_prior_a,shape2=my_prior_b))/pbeta(0.1,shape1 = my_prior_a,shape2=my_prior_b)
prior_odds_01
posterior_odds_01 <- (1-pbeta(0.1,shape1 = my_posterior_a,shape2=my_posterior_b))/(pbeta(0.1,shape1 = my_posterior_a,shape2=my_posterior_b)
)
posterior_odds_01

(posterior_odds_01/prior_odds_01)
# which is the conclusion according to the Bayes Factor? 
# we conclude in favor of H_1: theta < 0.1

# in order to calibrate a BF when BF<1 ....
1/(posterior_odds_01/prior_odds_01)

## if I want to test a point-null hypothesis 

# H_0 : theta=0.1=theta_0=0.1
#  against a composite (bidirectional) alternative
# H_1 : theta != 0.1

# we should look at the credible interval ad decide in favor of H_0 if theta_0 is inside the credible interval at a suitably large posterior probability content

theta_0 <- 0.1
(theta_0 >= interval_estimate_hpd[1]) & (theta_0 <= interval_estimate_hpd[2])




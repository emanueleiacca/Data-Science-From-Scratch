# 2) POSTERIOR ANALYSIS ---------------------------------------------------

# suppose we have observed y_obs=0 successes
# in a binomial trial out of N=20 attempts (tests)

y_obs <- 0
N <- 20


# a. derive the posterior distribution (conjugate updating formula) -------

# we know the analytic formula for the 
# posterior distribution if the prior is conveniently chosen 
# within the Beta family of distributions

# compute the updated hypeparameter h_post=(a_post,b_post)
my_posterior_a <- my_prior_a + y_obs
my_posterior_b <- my_prior_b + (N-y_obs)


h_posterior <- c(a=my_posterior_a,b=my_posterior_b)
h_posterior

mu_posterior <- (my_prior_a+y_obs)/(my_prior_a+my_prior_b+N)

mu_posterior

#    graphical display: prior, posterior, (likelihood) -----------------------


# plot the prior
par(mfrow=c(1,1))
curve(dbeta(x,shape1=my_prior_a,shape2=my_prior_b),from=0,to=1,col="blue",lwd=2,ylim=c(0,25),xlab=expression(theta),ylab=expression(paste(pi(theta),"",~~~"(prior or posterior)")),n=10000)
# plot the posterior
curve(dbeta(x,shape1=my_posterior_a,shape2=my_posterior_b),from=0,to=1,add=TRUE,col="orange",lwd=2,n=10000)

likelihood <- function(theta){
  choose(N,y_obs)*theta^y_obs*(1-theta)^(N-y_obs)
}

# is it a vectorized likelihood in this example? 

curve(20*likelihood(x),add=TRUE,col="red",lwd=2,lty=5)

# constant <- ??? 20
# curve(constant*likelihood(x),add=TRUE,col="red",lwd=2)

legend("topright",legend=c("prior","posterior"),col=c("blue","orange"),lty=c(1,1))

points(mu_prior,0,pch=16,cex=1.5,col="blue")
points(mu_posterior,0,pch=16,cex=1.5,col="orange")

theta_hat_MLE <- y_obs/N
points(theta_hat_MLE,0,pch=16,cex=1.5,col="red")

title(main="from-prior-to-posterior in a conjugate Bayesian analysis of a Binomial example")

# prior probability attached to the original 
# [0.05,0.20]
pbeta(0.20,shape1=my_prior_a,shape2=my_prior_b)-
  pbeta(0.05,shape1=my_prior_a,shape2=my_prior_b)

# new updated posterior probability attached to the original 
# [0.05,0.20]

pbeta(0.20,shape1=my_prior_a+0,shape2=my_prior_b+20)-
  pbeta(0.05,shape1=my_prior_a+0,shape2=my_prior_b+20)

# what if we elicited a different prior guess (say of prior prob 0.7)?
# we should compare the posterior prob of the interval with the elicited prior guess 

# while if I want to see how much my prior beliefs have been updated about the claim that the spread of the disease is lower that 10% i.e. theta<0.1 ...

pbeta(0.1,shape1=my_prior_a,shape2 = my_prior_b)
pbeta(0.1,shape1=my_posterior_a,shape2 = my_posterior_b)



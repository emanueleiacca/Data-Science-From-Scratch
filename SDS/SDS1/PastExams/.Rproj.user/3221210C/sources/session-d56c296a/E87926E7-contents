# c. INTERVAL  ESTIMATE ---------------------------------------------------
#    compute ET and HPD interval estimates -----------------------------------


posterior_cdf <- function(x){
  pbeta(x,shape1=my_prior_a+0,shape2=my_prior_b+20)
}

posterior_qf <- function(x){
  qbeta(x,shape1=my_posterior_a,shape2=my_posterior_b)
}

posterior_icdf <- function(x){
  qbeta(x,shape1=my_posterior_a,shape2=my_posterior_b)
}

# POSTERIOR DISTRIBUTION: 
# interval-estimate ===> equal tail 
# corresponding to posterior probability 1-alpha

alpha=0.05
1-alpha
posterior_qf(alpha/2)
posterior_qf(1-alpha/2)

interval_estimate_equal_tail <- c(posterior_qf(alpha/2),posterior_qf(1-alpha/2))
interval_estimate_equal_tail
# let us check its posterior probability content
pbeta(posterior_qf(1-alpha/2),shape1=my_posterior_a,shape2=my_posterior_b) - pbeta(posterior_qf(alpha/2),shape1=my_posterior_a,shape2=my_posterior_b)

interval_estimate_equal_tail <- c(posterior_qf(alpha/2),posterior_qf(1-alpha/2))

# ET credible interval bounds
interval_estimate_equal_tail

# ET credible interval width
diff(interval_estimate_equal_tail)


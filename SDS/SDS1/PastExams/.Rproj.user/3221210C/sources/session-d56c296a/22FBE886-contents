Let's see an empirical approach also:

```{r}
# unnormalized density function
unnormalized_density = function(theta) {
  exp(-theta^2 + theta)
}

# Sample from proposal distribution using a Normal 
theta_grid = seq(-5, 6, length.out = 10000)
dens_vals = unnormalized_density(theta_grid)

# Normalize to get empirical probabilities
norm_constant = sum(dens_vals) * (theta_grid[2] - theta_grid[1]) 
normalized_density_vals = dens_vals / norm_constant

#Sample empirically using prob
samples = sample(theta_grid, size = 1e5, replace = TRUE, prob = normalized_density_vals)

empirical_norm_constant = 1 / norm_constant
empirical_norm_constant

empirical_mean = mean(samples)
empirical_mean  

empirical_quantile_10 = quantile(samples, probs = 0.1)
empirical_quantile_10  

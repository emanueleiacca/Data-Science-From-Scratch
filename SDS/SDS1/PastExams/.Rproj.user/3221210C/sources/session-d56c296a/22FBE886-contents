# 2. Check P(\theta > 0.5)
1 - pbeta(0.5, alpha, beta)
```

Suppose we have observed the following 10 conditionally i.i.d. normal random variables with unknown mean \theta (theta) and known variance \sigma^2=100
```{r}
y_obs <- c(103.08, 66.5, 73.65, 77.04, 65.83, 75.84, 74.36, 68.52, 71.32, 70.33)
n <- length(y_obs)
sigma2 <- 100         # known variance
mu0 <- 75             # prior mean
tau2 <- 1.25          # prior variance
```

```{r}
theta <- seq(70, 80, length.out = 1000)
prior_density <- dnorm(theta, mu0, sd = sqrt(tau2))
plot(theta, prior_density)
# So SUBJECTIVE is right
```


```{r}
# Posterior 
post_var <- 1 / (n / sigma2 + 1 / tau2)
post_sd <- sqrt(post_var)

# Posterior mean
y_mean <- mean(y_obs)
print("Posterior mean")
post_mean <- post_var * (mu0 / tau2 + n * y_mean / sigma2)
post_mean
# Posterior mode = Posterior mean (normal is symmetric)
post_mode <- post_mean

# 80% credible interval
print("80% credible interval")
print("Lower Bound")
ci_lower <- qnorm(0.1, mean = post_mean, sd = post_sd)
ci_lower
print("Upper Bound")
ci_upper <- qnorm(0.9, mean = post_mean, sd = post_sd)
ci_upper
# Posterior probability that \theta < 73.5377528
x <- 73.5377528
posterior_prob <- pnorm(x, mean = post_mean, sd = post_sd)
print("Posterior probability that \theta < 73.5377528")
posterior_prob
# Prior odds that \theta < 73.5377528
prior_prob <- pnorm(x, mean = mu0, sd = sqrt(tau2))
prior_odds <- prior_prob / (1 - prior_prob)
print("Prior Odds that \theta < 73.5377528")
prior_odds
# Odds and Bayes Factor

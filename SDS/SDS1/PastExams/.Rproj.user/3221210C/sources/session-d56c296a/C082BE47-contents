```{r}
psi0 = 5.911721
tau0 <- 15
n <- 100
a <- 0.05
z = qnorm(1 -a/2)
M = 1000

# Define functions
tau <- function(psi) (2 - pi/2) * (psi^2) # defined as population variance
mle <- function(x) sqrt(sum(x^2) / (2 * length(x)))
se.tau <- function(x) (abs(2 * (2 - pi/2) * mle(x))) * (abs(mle(x))) / (2 * sqrt(length(x))) # it uses delta method

# Generate M samples and compute statistics iteratively
psi.mle.vec <- numeric(M)  # Store MLEs
tau.mle.vec <- numeric(M)  # Store tau estimates
tau.se.vec <- numeric(M)   # Store SEs

for (i in 1:M) {
  X <- rmy(n, psi = psi0)  # Generate a single sample
  psi.mle.vec[i] <- mle(X)  # Compute MLE
  tau.mle.vec[i] <- tau(psi.mle.vec[i])  # Compute tau
  tau.se.vec[i] <- se.tau(X)  # Compute standard error
}

# Compute test statistics
W <- abs((tau.mle.vec - tau0) / tau.se.vec)
mean(abs(W) > z)
```

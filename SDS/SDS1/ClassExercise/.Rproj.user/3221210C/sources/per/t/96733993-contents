### Algoritm/Estimator
```{r}
# Define the density of a Pareto
mydens <- function(x, alpha = 2) (alpha/(x^(alpha+1)))*(x >= 1)


# Check on the density
hist(mysamp, prob = T, breaks = 50) ## << transform of the data "capture" the "density" | ESTIMATOR/ALGORITHM
curve(mydens(x, alpha = 2.5), add = T, col = "blue", lwd = 4)

# Check on the CDF???
# What is the "equivalent" algorithm that try to learn the underlying CDF from data?
# Histogram <> ECDF > place mass 1/n over each datapoint >> consider the CDF of THAT 
#                     discrete distribution
plot(sort(mysamp), rep(1/n, n), type = "h", lty = 3, col = gray(.75))
points(sort(mysamp), rep(1/n, n), pch = 19)
rug(mysamp)


?ecdf

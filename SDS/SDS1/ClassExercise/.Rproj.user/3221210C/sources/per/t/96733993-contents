# LAB 5: Transformation Example 

```{r}

Fy <- function(y) 
  suppressWarnings(ifelse( y < 0, 0, sqrt(y)*(y<1)*(y>0) + (y > 1) ))
curve(Fy(x), -5, 5, lwd = 5, col = "pink",
      n = 500)


fy <- function(y) 
  suppressWarnings(ifelse( y < 0, 0, (1/(2*sqrt(y)))*(y<1)*(y>0) ))
curve(fy(x), -1, 2, lwd = 5, col = "orchid",
      n = 500)


# Case of a density whose values are blowing to infinity...
# Reinforce: density values are NOT probabilities!


# Study the transformation via simulation
# Requirement: be able to simualte from the orginal r.v. X


set.seed(31543) # for reproducibility
M <- 1000
xsamp <- runif(M, -1, +1)
hist(xsamp, prob = T, breaks = 25)


# Just apply the transformation to the OG samples
ysamp <- xsamp^2


hist(ysamp, prob = T)
curve(fy(x), add = TRUE, 
      lwd = 5, col = "orchid",
      n = 500)

```


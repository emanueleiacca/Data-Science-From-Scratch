# LAB 4: In class exercise | My options 

```{r}
# Alternative definition with boolean masks
myF <- function(x, alpha = 2) (1 - 1/(x^(alpha)))*(x >= 1)
curve(myF(x), 0, 10)


# More general stepfunctions in R
?stepfun # output is a <function> obj >> ECDF


# Alternative definition with boolean masks
myQ <- function(u, alpha = 2) ((1/(1-u))^(1/alpha))*(u >= 0)*(u <= 1)
curve(myQ(x), -4, 4)
myQ(-4)


# Basic input check and warning
myQv2 <- function(u, alpha = 2){
  if ( (u < 0) | (u > 1) ){
    warning("Out-of-bound input!")
  }
  ((1/(1-u))^(1/alpha))*(u >= 0)*(u <= 1)
}
myQv2(-4)
```

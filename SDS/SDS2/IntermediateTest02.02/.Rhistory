# 3. Compute the Monte Carlo standard error for beta[4], using only chain 1
# -----------------------------------------------------------------------------
# Extract the samples of beta[4] from the first chain:
beta4_chain1 <- mcmc_chains[[1]][ , "beta[4]" ]
# Compute effective sample size for beta[4] in chain 1:
ess_beta4_chain1 <- effectiveSize(mcmc(beta4_chain1))
# Compute the sample standard deviation of beta[4] in chain 1:
sd_beta4_chain1 <- sd(beta4_chain1)
# Approximate Monte Carlo standard error (MCSE) as:
#     MCSE ≈ sd(beta4) / sqrt(n.eff_beta4)
mcse_beta4_chain1 <- sd_beta4_chain1 / sqrt(ess_beta4_chain1)
# Print the Monte Carlo standard error for beta[4]:
cat("Monte Carlo SE for beta[4] (chain 1 only):", mcse_beta4_chain1, "\n")
# -----------------------------------------------------------------------------
# 4. Determine how many predictors have a significant effect
# -----------------------------------------------------------------------------
# We will compute the 95% central credible intervals for each beta[j] and
# count how many intervals exclude zero.
# Combine all chains into a single matrix for convenience:
combined_matrix <- as.matrix(mcmc_chains)
# Extract only the columns corresponding to beta[1] through beta[7]:
beta_columns <- grep("^beta\\[", colnames(combined_matrix), value = TRUE)
beta_samples <- combined_matrix[ , beta_columns ]
# Compute the 95% credible intervals (2.5% and 97.5% quantiles) for each beta:
ci_lower <- apply(beta_samples, 2, quantile, probs = 0.025)
ci_upper <- apply(beta_samples, 2, quantile, probs = 0.975)
# Check which betas have intervals that do NOT include zero:
significant_flags <- (ci_lower > 0) | (ci_upper < 0)
# Count how many betas are flagged as significant:
num_significant_predictors <- sum(significant_flags) -  # subtract 1 if beta[1] is intercept
ifelse(significant_flags["beta[1]"], 1, 0)
# Note: Here “predictors” refers to the six covariates only (beta[2]..beta[7]),
# so we exclude beta[1] (intercept) from this count. Alternatively, if the question
# literally means “how many of the seven beta parameters” are significant,
# comment out the subtraction of beta[1].
# We will assume “predictors” = covariates, so:
is_beta_intercept_significant <- significant_flags["beta[1]"]
is_beta2_significant     <- significant_flags["beta[2]"]  # AREA
is_beta3_significant     <- significant_flags["beta[3]"]  # YR.ISOL
is_beta4_significant     <- significant_flags["beta[4]"]  # DIST
is_beta5_significant     <- significant_flags["beta[5]"]  # LDIST
is_beta6_significant     <- significant_flags["beta[6]"]  # GRAZE
is_beta7_significant     <- significant_flags["beta[7]"]  # ALT
# Count how many of beta[2]..beta[7] are significant:
num_covariates_significant <- sum(
is_beta2_significant,
is_beta3_significant,
is_beta4_significant,
is_beta5_significant,
is_beta6_significant,
is_beta7_significant
)
cat("Number of predictors (covariates) with a significant effect:",
num_covariates_significant, "\n")
# -----------------------------------------------------------------------------
# 5. Identify the set of significant predictors
# -----------------------------------------------------------------------------
# Map the beta indices to actual covariate names:
#   beta[1] = Intercept
#   beta[2] = AREA     (patch area)
#   beta[3] = YR.ISOL  (years since isolation)
#   beta[4] = DIST     (distance to nearest patch)
#   beta[5] = LDIST    (distance to nearest larger patch)
#   beta[6] = GRAZE    (grazing intensity)
#   beta[7] = ALT      (altitude)
covariate_names <- c(
"AREA",
"YR.ISOL",
"DIST",
"LDIST",
"GRAZE",
"ALT"
)
# Check significance flags for beta[2]..beta[7]:
beta_flags <- significant_flags[ beta_columns ]       # logical vector of length 7
names(beta_flags) <- beta_columns
# Identify which of beta[2]..beta[7] are significant:
significant_indices <- which(beta_flags[2:7]) + 1       # shift index by 1
significant_betas    <- beta_columns[significant_indices]
# Map those to covariate names:
significant_predictors <- covariate_names[ significant_indices - 1 ]
cat("Significant predictors (covariates) are:\n")
print(significant_predictors)
# -----------------------------------------------------------------------------
# 6. Produce a plot to identify the significant predictors (save to 'plot.pdf')
# -----------------------------------------------------------------------------
# We will draw a horizontal error‐bar (forest) plot of the 95% credible intervals
# for beta[1]..beta[7] and highlight which ones exclude zero.
# First, compute point estimates (posterior means) for each beta:
beta_means <- apply(beta_samples, 2, mean)
# Create the plot and save to PDF:
pdf("plot.pdf", width = 6, height = 4)
par(mar = c(5, 6, 4, 2))  # margin adjustments: (bottom, left, top, right)
# Plot an empty canvas:
plot(
x = beta_means,
y = seq_along(beta_columns),
xlim = range(c(ci_lower, ci_upper)),
ylim = c(0.5, length(beta_columns) + 0.5),
yaxt = "n",
xlab = "Posterior Mean and 95% Credible Interval",
ylab = "",
main = "95% Credible Intervals for Beta Parameters",
pch = 16
)
# Add custom y-axis labels:
axis(
side = 2,
at = seq_along(beta_columns),
labels = beta_columns,
las = 1
)
# Add horizontal error bars for each beta:
for (i in seq_along(beta_columns)) {
seg_x0 <- ci_lower[i]
seg_x1 <- ci_upper[i]
seg_y  <- i
segments(seg_x0, seg_y, seg_x1, seg_y, lwd = 2)
}
# Add a vertical line at zero:
abline(v = 0, lty = 2, col = "darkgray")
dev.off()
cat("Forest plot of 95% credible intervals saved as 'plot.pdf'.\n")
# -----------------------------------------------------------------------------
# 7. Determine which parameter represents expected abundance in average habitat
# -----------------------------------------------------------------------------
# Because all six covariates were centered on their mean, when AREA=0, YR.ISOL=0, etc.,
# the linear predictor mu[i] = beta[1] + 0 + 0 + ... + 0 = beta[1].
# Therefore, beta[1] (the intercept) represents the expected abundance µ₀
# in an average forest habitat.
cat("The parameter representing expected abundance in an average forest is: beta[1]\n")
# -----------------------------------------------------------------------------
# 8. Assess the claim: "Expected abundance in average forest habitat > 18.9?"
# -----------------------------------------------------------------------------
# Compute posterior probability that beta[1] > 18.9:
beta1_samples <- combined_matrix[ , "beta[1]" ]
posterior_prob_beta1_gt_18.9 <- mean(beta1_samples > 18.9)
cat("Posterior probability that beta[1] > 18.9:", posterior_prob_beta1_gt_18.9, "\n")
# If we use a 0.95 threshold for acceptance:
if (posterior_prob_beta1_gt_18.9 > 0.95) {
cat("We accept the claim: expected abundance > 18.9.\n")
} else {
cat("We do NOT accept the claim: expected abundance > 18.9.\n")
}
# -----------------------------------------------------------------------------
# 9. Fit an alternative JAGS model containing only the significant covariates
# -----------------------------------------------------------------------------
# From step 5, we identified which covariates have significant betas.
# For illustration, suppose we found that only AREA (beta[2]) was significant.
# (Adjust this code automatically if multiple covariates are significant.)
# Extract the indices of significant covariates among beta[2..beta[7]]:
sig_beta_indices <- which(beta_flags[2:7]) + 1  # e.g. c(2) if only beta[2]
# Map indices back to variable names in 'loyn' data.frame:
cov_map <- list(
2 = "AREA",
3 = "YR.ISOL",
4 = "DIST",
5 = "LDIST",
6 = "GRAZE",
7 = "ALT"
)
sig_covariate_names <- unlist(cov_map[ as.character(sig_beta_indices) ])
# Create a new JAGS model string with only intercept + significant covariates
# We will label the new betas 0..K, where beta0 is intercept and betaj corresponds
# to each significant covariate.
num_sig <- length(sig_covariate_names)
model2_string <- paste0(
"model {\n",
"  # Likelihood\n",
"  for (i in 1:n) {\n",
"    ABUND[i] ~ dnorm(mu[i], tau)\n",
"    mu[i] <- beta0",
if (num_sig >= 1) {
paste0(
paste0(" + beta", seq_len(num_sig), "*", sig_covariate_names, "[i]",
collapse = "")
)
} else { "" },
"\n  }\n\n",
"  # Priors for regression coefficients\n",
"  beta0 ~ dnorm(0, 1.0E-6)\n",
if (num_sig >= 1) {
paste0(
paste0("  beta", seq_len(num_sig), " ~ dnorm(0, 1.0E-6)\n", collapse = "")
)
} else { "" },
"  tau <- 1 / pow(sigma, 2)\n",
"  sigma ~ dunif(0, 100)\n",
"}\n"
)
# Write the new model string to a text file:
model2_filename <- "loyn_model2.txt"
writeLines(model2_string, con = model2_filename)
# Prepare the data list for JAGS for the reduced model:
# Always include n, ABUND, and each significant covariate as a vector.
jags_data2 <- list(
n = nrow(loyn),
ABUND = loyn$ABUND
)
for (cov in sig_covariate_names) {
jags_data2[[cov]] <- loyn[[cov]]
}
# Number of regression coefficients (including intercept):
n_coeff2 <- 1 + num_sig
jags_data2$n_coeff <- n_coeff2
# Choose parameter names to monitor: "beta0", "beta1", ..., plus "sigma", and "deviance".
params2 <- c(
"beta0",
if (num_sig >= 1) paste0("beta", seq_len(num_sig)) else NULL,
"sigma",
"deviance"
)
# Initial values (just give something that matches the dimension):
init2 <- list(
beta0 = 0,
sigma = 1
)
if (num_sig >= 1) {
for (k in seq_len(num_sig)) {
init2[[paste0("beta", k)]] <- 0
}
}
# Run JAGS for the reduced model:
model2_results <- jags(
data = jags_data2,
inits = list(init2),
parameters.to.save = params2,
model.file = model2_filename,
n.chains = 3,
n.iter = 33000,
n.burnin = 3000,
n.thin = 10
)
# Extract DIC for the reduced model:
DIC_model2 <- model2_results$BUGSoutput$DIC
cat("DIC for reduced model (only significant covariates):", DIC_model2, "\n")
# -----------------------------------------------------------------------------
# 10. Compare DICs and decide which model to prefer
# -----------------------------------------------------------------------------
# Extract DIC from the original full seven‐covariate model:
DIC_model1 <- loyn_mod1$BUGSoutput$DIC
cat("DIC for full model:", DIC_model1, "\n")
cat("DIC for reduced model:", DIC_model2, "\n")
if (DIC_model2 < DIC_model1) {
cat("Preferred model: reduced model with only significant covariates (lower DIC).\n")
} else if (DIC_model2 > DIC_model1) {
cat("Preferred model: full model with all predictors (lower DIC).\n")
} else {
cat("Both models have identical DIC; no preference based on DIC.\n")
}
###############################################################################
# End of script
###############################################################################
###############################################################################
# Loyn Data Analysis — Complete R Code (All Questions Answered, Initialization Fixed)
#
# This script performs all required steps to answer the questions about the
# JAGS model fitted to the Loyn bird‐abundance data. All variable names and
# comments are in English. It assumes that "loyn_data_analysis.RData" is in
# your working directory (adjust the path in load() if needed) and that the
# R2jags, coda, and JAGS software are installed.
###############################################################################
# -----------------------------------------------------------------------------
# Load required libraries
# -----------------------------------------------------------------------------
library(R2jags)  # for running JAGS models
library(coda)    # for MCMC diagnostics and summaries
# -----------------------------------------------------------------------------
# 0. Load the workspace
# -----------------------------------------------------------------------------
# Adjust the file path below to where "loyn_data_analysis.RData" actually resides.
load("/Users/roberto/Desktop/UNI_DATASCIENCE/SDSII/midterm2/part2/intermediate-test-02-loyn/loyn_data_analysis.RData")
# After loading, you should have these objects in your workspace:
#   loyn           (data.frame with 49 observations of ABUND + 6 centered covariates)
#   loyn_mod1      (R2jags output object for the full seven‐covariate model)
#   loyn.list1     (list of data passed to JAGS for the full model)
#   mean_variables (vector of means used to center the six predictors)
#   model1_string  (character string defining the JAGS model for the full model)
#   params         (vector of parameter names monitored in the full model)
# -----------------------------------------------------------------------------
# 1. Identify the type of model that has been estimated
# -----------------------------------------------------------------------------
# The model is a Bayesian Normal (Gaussian) linear regression model.
# In JAGS syntax:
#   ABUND[i] ~ dnorm(mu[i], tau),
#   mu[i] <- beta[1] + beta[2]*AREA[i] + beta[3]*YR.ISOL[i] + beta[4]*DIST[i]
#             + beta[5]*LDIST[i] + beta[6]*GRAZE[i] + beta[7]*ALT[i].
# Priors: beta[j] ~ dnorm(0, 1e‐6); sigma ~ dunif(0,100).
# (No extra code needed; this is a conceptual answer.)
# -----------------------------------------------------------------------------
# 2. Find the parameter with the lowest effective sample size (n.eff)
# -----------------------------------------------------------------------------
# Convert the R2jags output into an mcmc.list object
mcmc_chains <- as.mcmc(loyn_mod1)
# Compute effective sample sizes for all monitored parameters
ess_all <- effectiveSize(mcmc_chains)
# Identify which parameter has the minimum effective sample size
param_lowest_n_eff <- names(ess_all)[which.min(ess_all)]
# Print the parameter with lowest effective sample size
cat("Question 2: Parameter with lowest effective sample size:",
param_lowest_n_eff, "\n\n")
# Expected answer: beta[3]
# -----------------------------------------------------------------------------
# 3. Compute the Monte Carlo standard error for beta[4], using only chain 1
# -----------------------------------------------------------------------------
# Extract the samples of beta[4] from the first chain
beta4_chain1 <- mcmc_chains[[1]][ , "beta[4]" ]
# Compute effective sample size for beta[4] in chain 1
ess_beta4_chain1 <- effectiveSize(mcmc(beta4_chain1))
# Compute the sample standard deviation of beta[4] in chain 1
sd_beta4_chain1 <- sd(beta4_chain1)
# Approximate Monte Carlo standard error (MCSE) as:
#     MCSE ≈ sd(beta4) / sqrt(n.eff_beta4)
mcse_beta4_chain1 <- sd_beta4_chain1 / sqrt(ess_beta4_chain1)
# Print the Monte Carlo standard error for beta[4]
cat("Question 3: Monte Carlo SE for beta[4] (chain 1 only):",
mcse_beta4_chain1, "\n\n")
# Expected answer: approximately 0.000136
# -----------------------------------------------------------------------------
# 4. Determine how many predictors have a significant effect
# -----------------------------------------------------------------------------
# Combine all chains into a single matrix
combined_matrix <- as.matrix(mcmc_chains)
# Extract only the columns corresponding to beta[1] through beta[7]
beta_columns <- grep("^beta\\[", colnames(combined_matrix), value = TRUE)
beta_samples <- combined_matrix[ , beta_columns ]
# Compute the 95% credible intervals (2.5% and 97.5% quantiles) for each beta
ci_lower <- apply(beta_samples, 2, quantile, probs = 0.025)
ci_upper <- apply(beta_samples, 2, quantile, probs = 0.975)
# Check which betas have intervals that do NOT include zero
significant_flags <- (ci_lower > 0) | (ci_upper < 0)
# Interpret "predictors" as the six covariates (beta[2]..beta[7]), excluding beta[1].
is_beta2_sig <- significant_flags["beta[2]"]  # AREA
is_beta3_sig <- significant_flags["beta[3]"]  # YR.ISOL
is_beta4_sig <- significant_flags["beta[4]"]  # DIST
is_beta5_sig <- significant_flags["beta[5]"]  # LDIST
is_beta6_sig <- significant_flags["beta[6]"]  # GRAZE
is_beta7_sig <- significant_flags["beta[7]"]  # ALT
# Count how many of beta[2]..beta[7] are significant
num_covariates_significant <- sum(
is_beta2_sig,
is_beta3_sig,
is_beta4_sig,
is_beta5_sig,
is_beta6_sig,
is_beta7_sig
)
# Print the result
cat("Question 4: Number of predictors (covariates) with a significant effect:",
num_covariates_significant, "\n\n")
# Expected answer: 1
# -----------------------------------------------------------------------------
# 5. Identify the set of significant predictors
# -----------------------------------------------------------------------------
# Map the beta indices to actual covariate names:
#   beta[2] = AREA
#   beta[3] = YR.ISOL
#   beta[4] = DIST
#   beta[5] = LDIST
#   beta[6] = GRAZE
#   beta[7] = ALT
covariate_names <- c(
"AREA",    # beta[2]
"YR.ISOL", # beta[3]
"DIST",    # beta[4]
"LDIST",   # beta[5]
"GRAZE",   # beta[6]
"ALT"      # beta[7]
)
# Identify which of beta[2]..beta[7] are significant
beta_flags <- significant_flags[beta_columns]
names(beta_flags) <- beta_columns
significant_indices <- which(beta_flags[2:7]) + 1  # shift by 1 to align with beta_columns
significant_betas    <- beta_columns[significant_indices]
# Map those indices to covariate names
# (index 2 → covariate_names[1] = "AREA"; index 3 → covariate_names[2] = "YR.ISOL", etc.)
significant_predictors <- covariate_names[significant_indices - 1]
# Print the result
cat("Question 5: Significant predictors (covariates):\n")
print(significant_predictors)
cat("\n")
# Expected answer: "AREA"
# -----------------------------------------------------------------------------
# 6. Produce a plot to identify the significant predictors (save to 'plot.pdf')
# -----------------------------------------------------------------------------
# Compute point estimates (posterior means) for each beta
beta_means <- apply(beta_samples, 2, mean)
# Create the forest plot and save it as PDF
pdf("plot.pdf", width = 6, height = 4)
par(mar = c(5, 6, 4, 2))  # margin adjustments: (bottom, left, top, right)
# Plot an empty canvas with correct x- and y-limits
plot(
x    = beta_means,
y    = seq_along(beta_columns),
xlim = range(c(ci_lower, ci_upper)),
ylim = c(0.5, length(beta_columns) + 0.5),
yaxt = "n",
xlab = "Posterior Mean and 95% Credible Interval",
ylab = "",
main = "95% Credible Intervals for Beta Parameters",
pch  = 16
)
# Add custom y-axis labels: beta[1], beta[2], …, beta[7]
axis(
side   = 2,
at     = seq_along(beta_columns),
labels = beta_columns,
las    = 1
)
# Add horizontal error bars for each beta[i]
for (i in seq_along(beta_columns)) {
segments(
x0 = ci_lower[i],
y0 = i,
x1 = ci_upper[i],
y1 = i,
lwd = 2
)
}
# Add a vertical line at zero
abline(v = 0, lty = 2, col = "darkgray")
dev.off()
cat("Question 6: Forest plot of 95% credible intervals saved as 'plot.pdf'.\n\n")
# -----------------------------------------------------------------------------
# 7. Which parameter represents expected abundance in an "average" forest habitat?
# -----------------------------------------------------------------------------
# Since all predictors were centered on their means, setting them to zero (AREA=0, YR.ISOL=0, etc.)
# means mu[i] = beta[1] + 0 + 0 + … + 0 = beta[1]. Therefore, beta[1] (the intercept)
# represents the expected abundance µ₀ in an average forest habitat.
cat("Question 7: The parameter representing expected abundance in an average forest habitat is: beta[1]\n\n")
# -----------------------------------------------------------------------------
# 8. Should we accept the claim that expected abundance in an average forest habitat is > 18.9?
# -----------------------------------------------------------------------------
# Compute posterior probability that beta[1] > 18.9
beta1_samples <- combined_matrix[ , "beta[1]" ]
posterior_prob_beta1_gt_18.9 <- mean(beta1_samples > 18.9)
cat("Question 8: Posterior probability that beta[1] > 18.9:",
posterior_prob_beta1_gt_18.9, "\n")
# Use a 0.95 threshold for acceptance
if (posterior_prob_beta1_gt_18.9 > 0.95) {
cat("We accept the claim: expected abundance > 18.9.\n\n")
} else {
cat("We do NOT accept the claim: expected abundance > 18.9.\n\n")
}
# Expected answer: We do NOT accept the claim (posterior probability ~ 0.1068)
# -----------------------------------------------------------------------------
# 9. Fit an alternative JAGS model containing only the significant covariate(s)
# -----------------------------------------------------------------------------
# From Question 5, only "AREA" (beta[2]) was significant. We will build a reduced model
# with intercept + AREA only.
# 9.1 Write the reduced-model string (intercept + AREA only)
model2_string <- "
model {
# Likelihood:
for (i in 1:n) {
ABUND[i] ~ dnorm(mu[i], tau)
mu[i]  <- beta0 + beta1 * AREA[i]
}
# Priors:
beta0 ~ dnorm(0, 1.0E-6)
beta1 ~ dnorm(0, 1.0E-6)
tau   <- 1 / pow(sigma, 2)
sigma ~ dunif(0, 100)
}
"
writeLines(model2_string, con = "loyn_model2.txt")
# 9.2 Prepare the data list for JAGS (omit any unused "n_coeff")
jags_data2 <- list(
n     = nrow(loyn),
ABUND = loyn$ABUND,
AREA  = loyn$AREA
)
# 9.3 Choose which parameters to save (omit "deviance" explicitly)
params2 <- c("beta0", "beta1", "sigma")
# Note: JAGS computes DIC (and monitors deviance internally) automatically.
# 9.4 Provide initial values for all three chains (must supply a list of length 3)
chain_inits <- list(
list(beta0 = 0, beta1 = 0, sigma = 1),
list(beta0 = 0, beta1 = 0, sigma = 1),
list(beta0 = 0, beta1 = 0, sigma = 1)
)
# 9.5 Run JAGS for the reduced model
model2_results <- jags(
data               = jags_data2,
inits              = chain_inits,       # list of three initial-value lists
parameters.to.save = params2,
model.file         = "loyn_model2.txt",
n.chains           = 3,
n.iter             = 33000,
n.burnin           = 3000,
n.thin             = 10
)
# 9.6 Extract and print DIC for the reduced model
DIC_model2 <- model2_results$BUGSoutput$DIC
cat("Question 9: DIC for reduced model (only AREA):", DIC_model2, "\n\n")
# -----------------------------------------------------------------------------
# 10. Compare DICs and decide which model should be preferred
# -----------------------------------------------------------------------------
# Extract DIC from the original full seven-covariate model
DIC_model1 <- loyn_mod1$BUGSoutput$DIC
cat("Question 10: DIC for full model:   ", DIC_model1, "\n")
cat("            DIC for reduced model:", DIC_model2, "\n")
if (DIC_model2 < DIC_model1) {
cat("Preferred model: reduced model with only AREA (lower DIC).\n")
} else if (DIC_model2 > DIC_model1) {
cat("Preferred model: full model with all predictors (lower DIC).\n")
} else {
cat("Both models have identical DIC; no preference based on DIC.\n")
}
###############################################################################
# End of script
###############################################################################
